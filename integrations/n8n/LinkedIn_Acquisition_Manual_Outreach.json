              "id": "campaign",
              "name": "acquisition_campaign_id",
              "value": "REPLACE_WITH_ACQUISITION_CAMPAIGN_UUID",
              "type": "string"
            },
            {
              "id": "endpoint",
              "name": "acquisition_import_url",
              "value": "https://revenueripple.org/api/acquisition/ingest",
