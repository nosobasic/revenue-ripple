    {
      "id": "26b6a667-abc9-40bf-beaa-588e4d6a547f",
      "name": "Normalize LinkedIn Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ],
      "parameters": {
        "jsCode": "// Supply extracted JSON rows from your existing scraper or CSV-reading workflow.\nconst incoming=$input.all().flatMap(i=>Array.isArray(i.json.data)?i.json.data:[i.json]);\nconst rows=incoming.map(row=>({name:row.name||row.Name||'',role:row.role||row.Role||'',company:row.company||row.Company||'',profileUrl:row.profileUrl||row['Profile URL']||''}));\nif(!rows.length || rows.some(r=>!r.profileUrl)) throw new Error('Supply LinkedIn rows with profileUrl; this export does not contain a LinkedIn scraper.');\nreturn [{json:{data:rows}}];"
      }
    },
    {
      "id": "96387d0e-63eb-408a-b6e7-6159846d4fe7",
      "name": "Prepare LinkedIn Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source=$('Split Items').item.json;\nlet output=$json.output;\nif(typeof output==='string') output=JSON.parse(output);\nif(!output?.message) throw new Error('AI response must contain message');\nreturn {json:{...source,output,acquisition:{campaign_id:$('Acquisition Configuration').first().json.acquisition_campaign_id,platform:'linkedin',source_url:source.profileUrl,author:source.name,role:source.role,company:source.company,source_title:[source.name,source.company].filter(Boolean).join(' \u2014 '),reply:output.message,workflow_name:'LinkedIn discovery drafts'}}};"
      }
    },
    {
      "id": "63dc29df-b3a5-44f6-b1b0-2dedecd5120f",
      "name": "Prepare Acquisition Import",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        150
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {json:$json.acquisition};"
      }
    },
    {
      "id": "0ff9990a-e079-40fa-b434-5a5637005d6e",
      "name": "Import Acquisition Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        150
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Acquisition Configuration').first().json.acquisition_import_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
