{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dlds/MembershipMastery.pdf", "destination": "/assets/downloads/MembershipMastery.pdf" },
    { "source": "/dlds/dmd", "destination": "/assets/downloads/digital-marketing.pdf" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
} 